# =============================================================================
# Integration Test Environment Configuration
# =============================================================================
# Copy this file to .env.test and fill in required values
# Some tests may require API keys for external services

# =============================================================================
# Database Configuration (Docker - Recommended)
# =============================================================================
# PostgreSQL Test Databases (Docker on port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/estara_test?sslmode=disable
MARKET_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/estara_market_test?sslmode=disable

# For manual setup (local PostgreSQL on port 5432), use these instead:
# DATABASE_URL=postgresql://localhost:5432/estara_test?sslmode=disable
# MARKET_DATABASE_URL=postgresql://localhost:5432/estara_market_test?sslmode=disable

# Redis Test Instance (Docker on port 6380)
REDIS_URL=redis://localhost:6380/1
REDIS_CACHE_URL=redis://localhost:6380/1

# Redis Pool Configuration
REDIS_POOL_SIZE=10
REDIS_TIMEOUT=5000
REDIS_RETRY_ATTEMPTS=3

# =============================================================================
# Authentication & Security
# =============================================================================
# Client JWT Secret (for auth tests)
CLIENT_JWT_SECRET=test-jwt-secret-for-integration-tests

# Auth.js Secret
AUTH_SECRET=test-auth-secret-change-in-production
AUTH_TRUST_HOST=true

# Cookie Configuration
COOKIE_DOMAIN=
COOKIE_SECURE=false
CSRF_TOKEN_LENGTH=32

# 2FA Encryption
TOTP_ENCRYPTION_KEY=test-totp-key-change-in-production

# Checkout Security
CHECKOUT_ENCRYPTION_KEY=test-checkout-key-change-in-production

# Callback JWT Secret
CALLBACK_JWT_SECRET=test-callback-jwt-secret

# Studio API Key
STUDIO_API_KEY=test-studio-api-key

# Cron Secret
CRON_SECRET=test-cron-secret

# =============================================================================
# Application URLs (Test Environment)
# =============================================================================
NEXT_PUBLIC_WWW_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_CLIENT_URL=http://localhost:3002
NEXT_PUBLIC_INVEST_MODEL_APP_URL=http://localhost:3002
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3500
WEBSITE_INTERNAL_URL=http://localhost:3500
STUDIO_FRONTEND_URL=http://localhost:3600

# Go backend URLs
CLIENT_URL=http://localhost:3002
MARKETING_URL=http://localhost:3500

# =============================================================================
# AI API Keys (Optional - some tests may need these)
# =============================================================================
# Anthropic (for AI evaluation tests)
ANTHROPIC_API_KEY=your-anthropic-key-here
NEXT_PUBLIC_ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_ADMIN_KEY=your-anthropic-admin-key-here

# OpenAI (for some AI features)
OPENAI_API_KEY=your-openai-key-here

# =============================================================================
# External Service API Keys (Optional - for specific tests)
# =============================================================================
# Property Data Providers
HASDATA_API_URL=https://api.hasdata.com
HASDATA_API_KEY=your-hasdata-key-here
HASDATA_CONCURRENT_CONNECTIONS=10
HASDATA_ROLLOUT_PERCENTAGE=100

BRIGHTDATA_MCP=your-brightdata-mcp-url-here

# Property Finder Configuration
PROPERTY_FINDER_PRIORITY=hasdata,brightdata,claude,public
PROPERTY_FINDER_CLAUDE_ENABLED=true
PROPERTY_FINDER_BRIGHTDATA_ENABLED=true
PROPERTY_FINDER_PUBLIC_ENABLED=false
PROPERTY_FINDER_HASDATA_ENABLED=true

# School & Location Data
SCHOOLDIGGER_API_KEY=your-schooldigger-key-here
SCHOOLDIGGER_API_ID=your-schooldigger-id-here
GEOCODIO_API_KEY=your-geocodio-key-here

# Economic Data APIs
FRED_API_KEY=your-fred-key-here
CENSUS_API_KEY=your-census-key-here
BLS_API_KEY=your-bls-key-here

# Search APIs
GOOGLE_SEARCH_API_KEY=your-google-search-key-here
GOOGLE_SEARCH_ENGINE_ID=your-search-engine-id-here
BRAVE_SEARCH_API_KEY=your-brave-search-key-here
BRAVE_SEARCH_URL=https://api.search.brave.com/res/v1/web/search

# Intercom (for support integration tests)
INTERCOM_ACCESS_TOKEN=your-intercom-token-here
INTERCOM_CLIENT_ID=your-intercom-client-id-here
INTERCOM_CLIENT_SECRET=your-intercom-client-secret-here

# =============================================================================
# Payment Integration (Optional - for billing tests)
# =============================================================================
# Stripe Test Keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-test-key-here
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-test-key-here
STRIPE_SECRET_KEY=sk_test_your-stripe-test-secret-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# Stripe Products (Test Mode)
STRIPE_PRICE_ANNUAL_ACCESS=price_test_your-price-id-here
STRIPE_PRODUCT_ANNUAL_ACCESS=prod_test_your-product-id-here
STRIPE_PRICE_PROFESSIONAL_ALLOCATOR=price_test_your-price-id-here
STRIPE_PRODUCT_PROFESSIONAL_ALLOCATOR=prod_test_your-product-id-here

# Apple IAP
APPLE_IAP_SHARED_SECRET=your-apple-shared-secret-here
APPLE_BUNDLE_ID=com.estara-ai.EstaraAI

# =============================================================================
# Email Service (Optional - for email tests)
# =============================================================================
MAILJET_API_KEY=your-mailjet-key-here
MAILJET_SECRET_KEY=your-mailjet-secret-here

# =============================================================================
# OAuth Providers (Optional - for OAuth tests)
# =============================================================================
# Google
GOOGLE_CLIENT_ID=your-google-client-id-here

# Microsoft Azure
AZURE_CLIENT_ID=your-azure-client-id-here
AZURE_TENANT_ID=your-azure-tenant-id-here
NEXT_PUBLIC_AZURE_CLIENT_ID=your-azure-client-id-here

# Apple Sign In
APPLE_CLIENT_ID=com.estara-ai.login
APPLE_TEAM_ID=your-apple-team-id-here
APPLE_KEY_ID=your-apple-key-id-here
APPLE_PRIVATE_KEY="your-apple-private-key-here"

# =============================================================================
# Storage (Optional - for file upload tests)
# =============================================================================
# Cloudflare R2
R2_ACCOUNT_ID=your-r2-account-id-here
R2_ACCESS_KEY_ID=your-r2-access-key-here
R2_SECRET_ACCESS_KEY=your-r2-secret-key-here
R2_S3_API=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=test-bucket

# =============================================================================
# Feature Flags & Configuration
# =============================================================================
# AI Cache Management
CACHE_MEMORY_LIMIT=20
CACHE_LOCALSTORAGE_LIMIT=5242880
CACHE_DEFAULT_TTL=86400000
CACHE_CLEANUP_INTERVAL=3600000
MAX_CACHE_SIZE_PER_USER=10485760

# AI Usage Tracking
AI_COST_TRACKING_ENABLED=true
AI_CACHE_ENABLED=true
MAX_MONTHLY_AI_COST_PREMIUM=5.00
MAX_MONTHLY_AI_COST_ENTERPRISE=25.00

# Feature Flags
USE_ADR038_COMPREHENSIVE_REPORT=true
RAG_RAO_ENABLED=true

# Server Configuration
WRITE_TIMEOUT=60s

# =============================================================================
# Image Service (Optional - for image-related tests)
# =============================================================================
PEXELS_API_KEY=your-pexels-key-here
