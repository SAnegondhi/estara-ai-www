# Integration Test Environment Configuration
# Copy to .env.test and fill in your Neon test branch URLs

# =============================================================================
# DATABASE (Neon PostgreSQL)
# =============================================================================
# Create a test branch in Neon dashboard for isolated testing
# Use pooled connection strings for better performance

# Main database (users, portfolios, cache L2, chat sessions)
DATABASE_URL=postgresql://user:pass@ep-xxx-test.us-east-2.aws.neon.tech/estara_test?sslmode=require

# Market database (Zillow time series, city-metro mappings)
MARKET_DATABASE_URL=postgresql://user:pass@ep-xxx-test.us-east-2.aws.neon.tech/market_test?sslmode=require

# =============================================================================
# REDIS (Local via docker-compose.test.yml)
# =============================================================================
REDIS_URL=redis://localhost:6380

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Use a dedicated test secret (never use production secret)
JWT_SECRET=test-secret-key-for-integration-tests-minimum-32-chars

# =============================================================================
# EXTERNAL APIS (Disabled for tests)
# =============================================================================
# Leave empty to disable external API calls during tests
BRIGHTDATA_API_KEY=
HASDATA_API_KEY=
ANTHROPIC_API_KEY=
FRED_API_KEY=

# =============================================================================
# CRON (Test secret)
# =============================================================================
CRON_SECRET=test-cron-secret

# =============================================================================
# SERVER
# =============================================================================
PORT=3001
ENV=test
